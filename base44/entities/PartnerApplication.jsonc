{
  "name": "PartnerApplication",
  "type": "object",
  "properties": {
    "org_name": {
      "type": "string",
      "description": "Organization legal name"
    },
    "contact_name": {
      "type": "string",
      "description": "Contact person full name"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "website": {
      "type": "string",
      "description": "Organization website"
    },
    "category": {
      "type": "string",
      "enum": [
        "education",
        "professional",
        "community"
      ],
      "description": "Partner category"
    },
    "description": {
      "type": "string",
      "description": "Organization description"
    },
    "licensing": {
      "type": "string",
      "description": "Licenses and credentials"
    },
    "contribution_model": {
      "type": "string",
      "enum": [
        "option-a",
        "option-b",
        "option-c"
      ],
      "description": "Preferred contribution model"
    },
    "why_partner": {
      "type": "string",
      "description": "Motivation to become a partner"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Application status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal admin notes"
    }
  },
  "required": [
    "org_name",
    "contact_name",
    "email",
    "category"
  ]
}